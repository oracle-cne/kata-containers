diff --git tools/osbuilder/image-builder/image_builder.sh tools/osbuilder/image-builder/image_builder.sh
index 5d01b0a2..ce1c6345 100755
--- tools/osbuilder/image-builder/image_builder.sh
+++ tools/osbuilder/image-builder/image_builder.sh
@@ -505,6 +505,15 @@ create_rootfs_image() {
 	sync
 	OK "rootfs copied"
 
+        info "Copying agent files to root partition"
+        : "${AGENT_SOURCE_DIR:?AGENT_SOURCE_DIR must identify the generated kata-agent units}"
+        info "Using generated agent units from ${AGENT_SOURCE_DIR}"
+        cp "${AGENT_SOURCE_DIR}"/kata-containers.target "${mount_dir}"/usr/lib/systemd/system/
+        cp "${AGENT_SOURCE_DIR}"/kata-agent.service "${mount_dir}"/usr/lib/systemd/system/kata-agent.service
+        sed -i 's|ExecStart=.*|ExecStart=/usr/bin/kata-agent|g' "${mount_dir}"/usr/lib/systemd/system/kata-agent.service
+        sync
+        OK "agent files copied"
+
	info "Setup systemd"
	setup_systemd "${mount_dir}"
